{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/why", "destination": "/why.html" },
    { "source": "/care", "destination": "/contact.html" },
    { "source": "/upgrades", "destination": "/upgrades.html" },
    { "source": "/club", "destination": "/club.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
