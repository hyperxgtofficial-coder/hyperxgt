# Copy to .env for local use, and set the same keys in Vercel > Settings > Environment Variables.
# Never commit real values. Only SUPABASE_ANON_KEY is safe to expose publicly.

# --- Admin portal -------------------------------------------------------------
# ADMIN_SECRET_KEY doubles as the x-admin-key bearer token for write APIs
# (products-crud, submit-review, collaborations, upload-image).
# The code falls back to a well-known default if this is unset — always set it in production.
ADMIN_EMAIL=admin@hyperxgt.com
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# --- Supabase (database, auth, storage) ---------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments -----------------------------------------------------------------
# Without these, /api/cashfree-order returns 503 and only Cash on Delivery is offered.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
RAZORPAY_KEY_SECRET=

# --- Transactional email (Resend) ---------------------------------------------
RESEND_API_KEY=
EMAIL_SENDER_NAME=HyperXGT
EMAIL_SENDER_ADDRESS=noreply@hyperxgt.com
REPLY_TO_ADDRESS=contact@hyperxgt.com
VERIFIED_DOMAIN=hyperxgt.com
USE_RESEND_DEV=false

# --- Shipping -----------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Site ---------------------------------------------------------------------
# Used for payment return/notify URLs. Must be the live origin in production.
SITE_URL=https://hyperxgt.com
BRAND_NAME=HyperXGT
